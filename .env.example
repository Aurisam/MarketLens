# Copy values into your terminal / PyCharm environment or hosting dashboard.
# This file is an example. Django does not automatically load .env files.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For the server, use the Neon connection string, including ?sslmode=require.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/database?sslmode=require
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
