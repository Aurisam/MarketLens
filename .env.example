# Aplinkos kintamųjų pavyzdžiai vietinei ir serverio aplinkai.
# Django šių failų automatiškai neskaito; reikšmės perduodamos procesui per aplinką.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL ryšio pavyzdžiai: įprastas aplikacijai, tiesioginis migracijoms.
# sslmode=require įjungia šifruotą ryšį; tikri slaptažodžiai į Git nesaugomi.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@direct-host/database?sslmode=require
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
